{
  "name": "schoolcity-web",
  "private": true,
  "version": "0.1.0",
  "description": "SchoolOS SchoolCity — public school directory (Next.js 14 App Router, SSR/ISR).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "quality:gate": "npm run audit:production && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/google.maps": "^3.65.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
